# ─────────────────────────────────────────────────────────────────────────────
# Spool PRODUCTION environment variables (free deploy, see docs/deploy-free.md).
#
# Setup:  Copy-Item .env.production.example .env.production
# Then fill in every <...> value. .env.production is in .gitignore. Never commit it.
#
# Where each variable is used:
#   [web]     → paste into Vercel: Project → Settings → Environment Variables
#   [worker]  → read by docker-compose.prod.yml on your PC
#   [both]    → needed in both places
# Tip: Vercel's env var screen accepts a whole .env file pasted into the first box.
# Pasting this file there is fine; the worker-only line is simply ignored by the web app.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# [web] The Spool site's address on Vercel (no trailing slash). Used for login email
# links and the embed/watch URLs the public API returns.
APP_ORIGIN=https://<your-spool-project>.vercel.app

# ── Storage: Cloudflare R2 ───────────────────────────────────────────────────
# [both] Account ID: Cloudflare dashboard → R2 → Overview (right-hand side).
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# [both] R2 always uses the region "auto".
S3_REGION=auto
# [both] Bucket name in the URL path. Works with R2 and matches local dev.
S3_FORCE_PATH_STYLE=true
# [both] From R2 → Manage API tokens → Create API token (Object Read & Write, both buckets).
# Cloudflare shows the secret ONCE. Copy it straight into this file.
S3_ACCESS_KEY=<r2-access-key-id>
S3_SECRET_KEY=<r2-secret-access-key>
# [both] Private bucket for original uploads.
S3_BUCKET=spool-originals
# [both] Public bucket for HLS + thumbnails.
S3_PUBLIC_BUCKET=spool-media
# [web] spool-media → Settings → Public access → "Public Development URL" (r2.dev).
# No trailing slash. (Later, a custom domain like https://media.yourdomain.com.)
S3_PUBLIC_URL=https://pub-<hash>.r2.dev

# [web] Largest upload in MB. 500 keeps one upload from using up the 10 GB free tier.
NEXT_PUBLIC_MAX_UPLOAD_MB=500

# ── Queue: Redis Cloud ───────────────────────────────────────────────────────
# [both] Redis Cloud → your database → Connect → "Redis CLI"/"Client": user is
# "default", password under Security. Format: redis://default:<password>@<host>:<port>
# (If your database has TLS turned on, the URL starts with rediss:// instead.)
REDIS_URL=redis://default:<password>@<host>:<port>

# ── Supabase (the same project as local dev) ─────────────────────────────────
# [both] URL. [web] publishable key. [both] secret key (server/worker only).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>
SUPABASE_SECRET_KEY=sb_secret_<...>

# ── TMDB ─────────────────────────────────────────────────────────────────────
# [web] The same token as in your local .env (leave empty to turn TMDB linking off).
TMDB_READ_ACCESS_TOKEN=

# ── Worker ───────────────────────────────────────────────────────────────────
# [worker] One video at a time is plenty for a PC.
WORKER_CONCURRENCY=1
