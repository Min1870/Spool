# ─────────────────────────────────────────────────────────────────────────────
# Spool environment variables.
#
# Setup:  copy .env.example .env      (PowerShell/cmd)
# One .env at the repo root is used by docker-compose, the web app and the worker.
# .env is in .gitignore. Never commit real secrets.
#
# The values below WORK OUT OF THE BOX FOR LOCAL DEV ONLY. They are throwaway
# credentials for the Garage container on your machine. For production (R2),
# replace them with real values from the Cloudflare dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# Where the Next.js app runs. Storage CORS allows uploads from this origin only.
APP_ORIGIN=http://localhost:3000

# ── Storage (S3-compatible) ──────────────────────────────────────────────────
# Switching Garage → Cloudflare R2 means changing ONLY this block.
#
# S3 API endpoint used by the web app (runs on your machine).
#   Local:  http://localhost:3900
#   R2:     https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=http://localhost:3900
# Signing region. Garage: "garage" (must match garage/garage.toml). R2: "auto".
S3_REGION=garage
# Garage wants bucket names in the URL path (http://host/bucket/key). R2 works either way.
S3_FORCE_PATH_STYLE=true
# Access key pair. Garage keys conventionally look like "GK" + hex, secret = 64 hex chars.
S3_ACCESS_KEY=GK31c2f218a2e44f485b94239e
S3_SECRET_KEY=b892c0665f0ada8a4755dae98baa3b133590e11dae3bcc1f9d8b0abd1c4e1fc5
# Private bucket: original uploads (originals/{videoId}/...). Never public.
S3_BUCKET=spool-originals
# Public bucket: HLS output + thumbnails (hls/{videoId}/...).
S3_PUBLIC_BUCKET=spool-media
# Public base URL browsers use to read files from S3_PUBLIC_BUCKET (no trailing slash).
#   Local:  http://<S3_PUBLIC_BUCKET>.web.garage.localhost:3902
#   R2:     https://media.yourdomain.com   (custom domain on the public bucket)
S3_PUBLIC_URL=http://spool-media.web.garage.localhost:3902

# Largest upload allowed, in megabytes (10240 = 10 GB). Checked in the browser AND
# again on the server before any upload URL is signed. NEXT_PUBLIC_ = visible to the browser.
NEXT_PUBLIC_MAX_UPLOAD_MB=10240

# ── Garage only (local dev) ──────────────────────────────────────────────────
# Internal secrets for the Garage container. Not used in production.
# RPC secret: exactly 64 hex characters.
GARAGE_RPC_SECRET=4f1d6a0b9c8e7d6f5a4b3c2d1e0f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f
GARAGE_ADMIN_TOKEN=local-dev-admin-token-change-me

# ── Queue ────────────────────────────────────────────────────────────────────
# Redis connection for BullMQ.
#   Web app (on your machine):  redis://localhost:6379
#   The worker (inside Docker) is pointed at redis://redis:6379 by docker-compose.
REDIS_URL=redis://localhost:6379

# ── Supabase (database + auth) ───────────────────────────────────────────────
# From your Supabase project dashboard (filled in during phase 2):
#   Project URL:  Settings → Data API (or the "Connect" button)
#   Keys:         Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...): safe in the browser. What it can read or
# write is limited by Row Level Security policies in the database.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (sb_secret_...): full database access, bypasses Row Level Security.
# SERVER-SIDE ONLY (API routes + worker). Never prefix it with NEXT_PUBLIC_.
# Supabase refuses it if it's sent from a browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# ── Worker ───────────────────────────────────────────────────────────────────
# How many videos the worker transcodes at the same time. FFmpeg is CPU-heavy,
# so keep this at 1 on a laptop or small VPS.
WORKER_CONCURRENCY=1
